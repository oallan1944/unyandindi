{
  "name": "huru-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/styled-engine-sc": "^7.0.2",
    "@mui/x-date-pickers": "^8.2.0",
    "@reduxjs/toolkit": "^2.8.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "axios": "^1.9.0",
    "dayjs": "^1.11.13",
    "formik": "^2.4.6",
    "framer-motion": "^12.16.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.513.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.5.1",
    "react-scripts": "5.0.1",
    "react-slick": "^0.30.3",
    "react-toastify": "^11.0.5",
    "redux-thunk": "^3.1.0",
    "slick-carousel": "^1.8.1",
    "styled-components": "^6.1.17",
    "swiper": "^11.2.10",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "yup": "^1.6.1"
  },
  "scripts": {
    "start": "cross-env CI=false react-scripts start",
    "build": "cross-env CI=false react-scripts build",
    "build:strict": "cross-env CI=true react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "lint:report": "eslint \"src/**/*.{ts,tsx}\" --format json --output-file lint-report.json || true",
    "lint:budget": "node scripts/check-lint-budget.js",
    "fix:react-imports": "node scripts/fix-unused-react-imports.js"
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"],
    "plugins": ["unused-imports"],
    "rules": {
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": "off",
      "unused-imports/no-unused-imports": "error",
      "unused-imports/no-unused-vars": [
        "warn",
        { "vars": "all", "varsIgnorePattern": "^_", "args": "after-used", "argsIgnorePattern": "^_" }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react-slick": "^0.23.13",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19"
  }
}